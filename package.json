{
  "name": "@signalsafe/simulator-core",
  "version": "0.4.1",
  "type": "module",
  "description": "Headless TreeSpec session runtime: step scenarios, accumulate scores, resolve outcomes \u2014 no UI or transport.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SignalSafeSoftware/simulator-core.git"
  },
  "bugs": {
    "url": "https://github.com/SignalSafeSoftware/simulator-core/issues"
  },
  "homepage": "https://github.com/SignalSafeSoftware/simulator-core#readme",
  "keywords": [
    "tree-spec",
    "simulator",
    "decision-tree",
    "scenario",
    "training",
    "phishing",
    "security-awareness",
    "typescript",
    "runtime",
    "session",
    "headless",
    "signalsafe"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "RELEASING.md"
  ],
  "engines": {
    "node": ">=19.0.0"
  },
  "packageManager": "yarn@1.22.22",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint src tests --deny-warnings",
    "typecheck": "tsc --noEmit",
    "publish:dry-run": "npm publish --dry-run",
    "smoke:package": "node scripts/smoke-package.mjs",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:coverage": "yarn test --coverage",
    "format": "oxfmt src tests",
    "format:check": "oxfmt --check src tests"
  },
  "dependencies": {
    "@signalsafe/tree-spec": "^0.4.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.76.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
